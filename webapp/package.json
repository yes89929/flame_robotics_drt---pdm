{
  "name": "pdm-web",
  "version": "0.1.0",
  "private": true,
  "description": "PDM 개인용 웹 도구 — URDF 뷰어·점군/검사점·PDM 테스트",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "conda run --no-capture-output -n drt-pdm --cwd server python -m pdm_web",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:api": "conda run --no-capture-output -n drt-pdm --cwd server python -m pytest -q tests"
  },
  "dependencies": {
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "puppeteer-core": "^23.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
